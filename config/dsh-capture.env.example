# Optional local DSH read-only matter/receipt lookup. Blank disables /mcp.
# Independently generate a URL-safe random token (32–128 chars).
TODO_DSH_CAPTURE_TOKEN=
# Optional key shared only by To Do and the native Harness Host approval code.
# Independently generate another URL-safe random token (32–128 chars).
# Blank or equal to TODO_DSH_CAPTURE_TOKEN disables approved creation and completion.
# Never send this key as a bearer or expose it in agent tools or browser config.
TODO_DSH_DIRECT_TOKEN=

# Expose bounded, read-only event candidates on the local MCP connection.
TODO_DSH_EVENT_LOOKUP=0
# Separately authorize sending selected DSH text to the configured embedding service.
# The source/Feishu embedding switch does not apply to DSH.
TODO_DSH_EVENT_EMBEDDING_CONSENT=0
# Set only after calibration: <current embedding profile>:<maximum cosine distance>.
TODO_DSH_EVENT_VECTOR_CALIBRATION=
